+void frame_capture_after_submit() noexcept {
+  std::vector<size_t> pending;
+  {
+    std::lock_guard lock{capture::g_mutex};
+    if (!capture::g_toMap) {
+      return;
+    }
+    capture::g_toMap = false;
+    capture::g_pending = static_cast<uint32_t>(capture::g_items.size());
+    if (capture::g_pending == 0) {
+      capture::finish();
+      return;
+    }
+  }
+  for (size_t i = 0;; ++i) {
+    wgpu::Buffer buffer;
+    uint64_t bytes = 0;
+    {
+      std::lock_guard lock{capture::g_mutex};
+      if (i >= capture::g_items.size()) break;
+      buffer = capture::g_items[i].buffer;
+      bytes = uint64_t(capture::g_items[i].rowBytes) * capture::g_items[i].height;
+    }
+    buffer.MapAsync(wgpu::MapMode::Read, 0, bytes, wgpu::CallbackMode::AllowSpontaneous,
+                    [i, bytes](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                      std::lock_guard lock{capture::g_mutex};
+                      if (i >= capture::g_items.size()) return;
+                      auto& item = capture::g_items[i];
+                      if (status == wgpu::MapAsyncStatus::Success) {
+                        if (const void* data = item.buffer.GetConstMappedRange(0, bytes)) {
+                          capture::write_item(item, static_cast<const uint8_t*>(data));
+                        }
+                        item.buffer.Unmap();
+                      }
+                      if (--capture::g_pending == 0) capture::finish();
+                    });
+  }
