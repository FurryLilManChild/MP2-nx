+
+// ---- Port (mp2-nx frame capture): the left stick click on the Switch (switch_menu.cpp) asks for one;
+// the next frame's render passes each save their colour target at the pass end, and each EFB copy its
+// destination, as PAM files (RGBA, 8 bits) in a folder of their own, with passes.txt listing every pass.
+// Both renderers go through here, so a Vulkan capture and a deko3d one of the same spot compare pass by
+// pass. deko3d's bridge adds draws.txt (every draw of the frame) while aurora_frame_capture_dir() is set.
+namespace capture {
+struct Item {
+  wgpu::Buffer buffer;
+  uint32_t width = 0, height = 0, rowBytes = 0, texel = 0;
+  wgpu::TextureFormat format = wgpu::TextureFormat::Undefined;
+  std::string file;
+};
+std::mutex g_mutex;
+std::string g_requestDir;           // set by aurora_frame_capture_request, taken by the next pass
+std::string g_dir;                  // the capture being recorded or saved ("" none)
+bool g_recording = false;
+bool g_toMap = false;               // the capture's frame is over: its buffers map at the next after_submit
+uint64_t g_frameId = 0;
+std::vector<Item> g_items;
+std::string g_text;
+uint32_t g_pending = 0;
+uint32_t g_written = 0;
+std::string g_lastDone;             // the last finished capture's folder (the toast)
+uint32_t g_doneCount = 0;
+constexpr size_t kMaxItems = 64;
+
+uint32_t texel_bytes(wgpu::TextureFormat f) {
+  switch (f) {
+  case wgpu::TextureFormat::RGBA8Unorm:
+  case wgpu::TextureFormat::RGBA8UnormSrgb:
+  case wgpu::TextureFormat::BGRA8Unorm:
+  case wgpu::TextureFormat::BGRA8UnormSrgb:
+  case wgpu::TextureFormat::R32Float:
+    return 4;
+  case wgpu::TextureFormat::RGBA16Float:
+    return 8;
+  case wgpu::TextureFormat::R8Unorm:
+    return 1;
+  case wgpu::TextureFormat::RG8Unorm:
+  case wgpu::TextureFormat::R16Float:
+    return 2;
+  default:
+    return 0;
+  }
+}
+
+float half_to_float(uint16_t h) {
+  const uint32_t sign = (h >> 15) & 1, exp = (h >> 10) & 0x1F, man = h & 0x3FF;
+  float v;
+  if (exp == 0) {
+    v = std::ldexp(static_cast<float>(man), -24);
+  } else if (exp == 31) {
+    v = man ? 0.f : 65504.f;
+  } else {
+    v = std::ldexp(static_cast<float>(man | 0x400), static_cast<int>(exp) - 25);
+  }
+  return sign ? -v : v;
+}
+
+uint8_t unorm8(float v) { return static_cast<uint8_t>(std::clamp(v, 0.f, 1.f) * 255.f + 0.5f); }
+
+// Called with g_mutex held.
+void add(wgpu::CommandEncoder& cmd, const wgpu::Texture& texture, uint32_t width, uint32_t height,
+         const std::string& file, std::string& note) {
+  if (!texture || width == 0 || height == 0) {
+    note += " (no texture)";
+    return;
+  }
+  const wgpu::TextureFormat format = texture.GetFormat();
+  const uint32_t texel = texel_bytes(format);
+  if (texel == 0) {
+    note += fmt::format(" (format {} not saved)", static_cast<int>(format));
+    return;
+  }
+  if (g_items.size() >= kMaxItems) {
+    note += " (not saved: the capture is full)";
+    return;
+  }
+  Item item;
+  item.width = width;
+  item.height = height;
+  item.texel = texel;
+  item.format = format;
+  item.rowBytes = (width * texel + 255) & ~255u;
+  item.file = file;
+  const wgpu::BufferDescriptor desc{
+      .label = "Frame capture",
+      .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+      .size = uint64_t(item.rowBytes) * height,
+  };
+  item.buffer = g_device.CreateBuffer(&desc);
+  const wgpu::TexelCopyTextureInfo src{.texture = texture};
+  const wgpu::TexelCopyBufferInfo dst{
+      .layout = wgpu::TexelCopyBufferLayout{.offset = 0, .bytesPerRow = item.rowBytes, .rowsPerImage = height},
+      .buffer = item.buffer,
+  };
+  const wgpu::Extent3D size{.width = width, .height = height, .depthOrArrayLayers = 1};
+  cmd.CopyTextureToBuffer(&src, &dst, &size);
+  note += fmt::format(" -> {} (format {})", file, static_cast<int>(format));
+  g_items.push_back(std::move(item));
+}
+
+void write_item(const Item& item, const uint8_t* data) {
+  std::vector<uint8_t> out;
+  const std::string header = fmt::format("P7\nWIDTH {}\nHEIGHT {}\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n",
+                                         item.width, item.height);
+  out.reserve(header.size() + size_t(item.width) * item.height * 4);
+  out.insert(out.end(), header.begin(), header.end());
+  for (uint32_t y = 0; y < item.height; ++y) {
+    const uint8_t* row = data + size_t(y) * item.rowBytes;
+    for (uint32_t x = 0; x < item.width; ++x) {
+      const uint8_t* t = row + size_t(x) * item.texel;
+      uint8_t px[4] = {0, 0, 0, 255};
+      switch (item.format) {
+      case wgpu::TextureFormat::BGRA8Unorm:
+      case wgpu::TextureFormat::BGRA8UnormSrgb:
+        px[0] = t[2], px[1] = t[1], px[2] = t[0], px[3] = t[3];
+        break;
+      case wgpu::TextureFormat::RGBA16Float: {
+        uint16_t h[4];
+        std::memcpy(h, t, 8);
+        for (int c = 0; c < 4; ++c) px[c] = unorm8(half_to_float(h[c]));
+      } break;
+      case wgpu::TextureFormat::R8Unorm:
+        px[0] = px[1] = px[2] = t[0];
+        break;
+      case wgpu::TextureFormat::RG8Unorm:
+        px[0] = t[0], px[1] = t[1];
+        break;
+      case wgpu::TextureFormat::R16Float: {
+        uint16_t h;
+        std::memcpy(&h, t, 2);
+        px[0] = px[1] = px[2] = unorm8(half_to_float(h));
+      } break;
+      case wgpu::TextureFormat::R32Float: {
+        float f;
+        std::memcpy(&f, t, 4);
+        px[0] = px[1] = px[2] = unorm8(f);
+      } break;
+      default:
+        std::memcpy(px, t, 4);
+        break;
+      }
+      out.insert(out.end(), px, px + 4);
+    }
+  }
+  const std::string path = g_dir + "/" + item.file;
+  if (FILE* f = std::fopen(path.c_str(), "wb")) {
+    std::fwrite(out.data(), 1, out.size(), f);
+    std::fclose(f);
+    ++g_written;
+  } else {
+    Log.warn("frame capture: could not write {}", path);
+  }
+}
+
+// Called with g_mutex held, once every saved item has been written (or failed).
+void finish() {
+  g_text += fmt::format("\n{} of {} pictures saved\n", g_written, g_items.size());
+  const std::string path = g_dir + "/passes.txt";
+  if (FILE* f = std::fopen(path.c_str(), "wb")) {
+    std::fwrite(g_text.data(), 1, g_text.size(), f);
+    std::fclose(f);
+  }
+  Log.info("frame capture: {} ({} pictures)", g_dir, g_written);
+  g_lastDone = g_dir;
+  ++g_doneCount;
+  g_items.clear();
+  g_text.clear();
+  g_dir.clear();
+}
+
+void on_pass(wgpu::CommandEncoder& cmd, const FramePacket& frame, const RenderPass& p, uint32_t passIndex) {
+  std::lock_guard lock{g_mutex};
+  if (g_recording && frame.frameId != g_frameId) {
+    // the next frame's first pass: the capture is complete (its passes were all encoded before this one)
+    g_recording = false;
