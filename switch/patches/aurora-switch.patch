+// mp2-nx (the native map build): the state a GX draw issued now would be transformed and rasterised with, for
+// a caller that expands GX lines itself (the map screen's batched surfaces, CMapArea.cpp): the FIFO is drained
+// first (as vfx::draw_triangles does), so the state is the one the next draw will see. pn: the current position
+// matrix's three rows; proj: the projection's four rows as GXSetProjection set them (shader_info.cpp changes only
+// the z row); vp: the render and logical viewport sizes; lineWidth: GXSetLineWidth's width in logical pixels.
+#include "fifo.hpp"
+extern "C" void aurora_gx_drawing_state(float pn[12], float proj[16], float vp[4], float* lineWidth, int* cullMode) {
+  using namespace aurora::gx;
