+// Never render past what the current mode can show, scaled proportionally.
+static void switch_clamp(int& fb_w, int& fb_h, int native_w, int native_h) {
+  if (fb_w <= native_w && fb_h <= native_h) {
+    return;
+  }
+  const double k = std::min(static_cast<double>(native_w) / fb_w, static_cast<double>(native_h) / fb_h);
+  fb_w = std::max(1, static_cast<int>(fb_w * k));
+  fb_h = std::max(1, static_cast<int>(fb_h * k));
+}
+#endif
