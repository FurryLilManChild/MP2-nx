+    wgsl.code = source.c_str();
+    static constexpr const char* labels[3] = {"mp2-nx Map Module", "mp2-nx Map Module (dst alpha)",
+                                              "mp2-nx Map Module (dst alpha, dual source)"};
+    const wgpu::ShaderModuleDescriptor md{.nextInChain = &wgsl, .label = labels[mode]};
+    g_map.modules[mode] = ctx.device.CreateShaderModule(&md);
+  }
+  if (!g_map.bindLayout) {
+    const wgpu::BindGroupLayoutEntry entry{
