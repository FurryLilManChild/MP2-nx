+    const wgpu::BindGroupLayoutDescriptor bl{.label = "mp2-nx Map Bind Group Layout", .entryCount = 1, .entries = &entry};
+    g_map.bindLayout = ctx.device.CreateBindGroupLayout(&bl);
+    const wgpu::PipelineLayoutDescriptor pl{
+        .label = "mp2-nx Map Pipeline Layout", .bindGroupLayoutCount = 1, .bindGroupLayouts = &g_map.bindLayout};
+    g_map.pipelineLayout = ctx.device.CreatePipelineLayout(&pl);
+  }
+  static constexpr std::array<wgpu::VertexAttribute, 5> attributes{{
+      {.format = wgpu::VertexFormat::Float32x3, .offset = offsetof(AuroraMapInstance, p0), .shaderLocation = 0},
+      {.format = wgpu::VertexFormat::Float32x3, .offset = offsetof(AuroraMapInstance, p1), .shaderLocation = 1},
+      {.format = wgpu::VertexFormat::Float32x3, .offset = offsetof(AuroraMapInstance, p2), .shaderLocation = 2},
+      {.format = wgpu::VertexFormat::Unorm8x4, .offset = offsetof(AuroraMapInstance, color), .shaderLocation = 3},
+      {.format = wgpu::VertexFormat::Float32, .offset = offsetof(AuroraMapInstance, kind), .shaderLocation = 4},
+  }};
+  const wgpu::VertexBufferLayout vertexLayout{
+      .stepMode = wgpu::VertexStepMode::Instance,
+      .arrayStride = sizeof(AuroraMapInstance),
+      .attributeCount = attributes.size(),
+      .attributes = attributes.data(),
+  };
+  const wgpu::BlendState blend{
+      .color = {.operation = static_cast<wgpu::BlendOperation>(key.colorOp),
+                .srcFactor = static_cast<wgpu::BlendFactor>(key.colorSrc),
+                .dstFactor = static_cast<wgpu::BlendFactor>(key.colorDst)},
+      .alpha = {.operation = static_cast<wgpu::BlendOperation>(key.alphaOp),
+                .srcFactor = static_cast<wgpu::BlendFactor>(key.alphaSrc),
+                .dstFactor = static_cast<wgpu::BlendFactor>(key.alphaDst)},
+  };
+  std::array<wgpu::ColorTargetState, gfx::MaxColorAttachments> targets{};
+  for (uint32_t i = 0; i < ctx.layout.colorAttachmentCount; ++i) {
+    const bool scene = i == gfx::SceneColorAttachmentIndex;
+    targets[i] = {
+        .format = ctx.layout.colorAttachments[i].format,
+        .blend = scene ? &blend : nullptr,
+        .writeMask = scene ? static_cast<wgpu::ColorWriteMask>(key.writeMask) : wgpu::ColorWriteMask::None,
+    };
+  }
+  const wgpu::FragmentState fragment{
+      .module = g_map.modules[mode],
+      .entryPoint = "fs_main",
+      .targetCount = ctx.layout.colorAttachmentCount,
+      .targets = targets.data(),
+  };
+  const wgpu::DepthStencilState depth{
+      .format = ctx.layout.depthStencilFormat,
+      .depthWriteEnabled = key.depthWrite != 0,
+      .depthCompare = static_cast<wgpu::CompareFunction>(key.depthCompare),
+      .depthBias = key.depthBias,
+      .depthBiasSlopeScale = key.slope,
+      .depthBiasClamp = key.clamp,
+  };
+  const wgpu::RenderPipelineDescriptor descriptor{
+      .label = "mp2-nx Map Pipeline",
+      .layout = g_map.pipelineLayout,
+      .vertex = {.module = g_map.modules[mode], .entryPoint = "vs_main", .bufferCount = 1, .buffers = &vertexLayout},
+      .primitive = {.topology = wgpu::PrimitiveTopology::TriangleList,
+                    .frontFace = wgpu::FrontFace::CW,
+                    .cullMode = static_cast<wgpu::CullMode>(key.cull)},
+      .depthStencil = ctx.layout.depthStencilFormat != wgpu::TextureFormat::Undefined ? &depth : nullptr,
+      .multisample = {.count = ctx.layout.sampleCount, .mask = UINT32_MAX},
+      .fragment = &fragment,
+  };
+  wgpu::RenderPipeline pipeline = ctx.device.CreateRenderPipeline(&descriptor);
+  std::fprintf(stderr,
+               "map: GPU path: pipeline %zu made in %.1f ms (%s; %u colour targets, %u samples, cull %u, depth "
+               "compare %u, depth write %u, alpha mode %u (0 plain, 1 constant dst alpha, 2 that with dual source), "
+               "blend colour %u/%u/%u alpha %u/%u/%u, write mask %u)\n",
+               g_map.pipes.size() + 1, double(map_now_ns() - t0) / 1e6, pipeline ? "ok" : "FAILED",
+               ctx.layout.colorAttachmentCount, ctx.layout.sampleCount, key.cull, key.depthCompare, key.depthWrite,
+               mode, key.colorOp, key.colorSrc, key.colorDst, key.alphaOp, key.alphaSrc, key.alphaDst, key.writeMask);
+  if (pipeline) {
+    g_map.pipes.push_back(MapPipe{key, ctx.layout.key, ctx.layout.sampleCount, pipeline});
+  }
+  return pipeline;
+}
+
+void map_draw_cb(const gfx::DrawContext& ctx, const wgpu::RenderPassEncoder& pass, const void* data, size_t size,
+                 void*) {
+  if (size != sizeof(MapPayload)) {
+    return;
+  }
+  MapPayload p;
+  std::memcpy(&p, data, sizeof(p));
+  const wgpu::RenderPipeline pipeline = map_pipeline(ctx, p.key);
+  if (!pipeline) {
+    if (!g_map.failedOnce) {
+      g_map.failedOnce = true;
+      std::fprintf(stderr, "map: GPU path: no pipeline, the map draw was skipped\n");
+    }
+    return;
+  }
+  if (!g_map.group || g_map.groupBuffer != ctx.uniformBuffer.Get()) {
+    const wgpu::BindGroupEntry entry{.binding = 0, .buffer = ctx.uniformBuffer, .size = sizeof(MapUniform)};
+    const wgpu::BindGroupDescriptor bd{
+        .label = "mp2-nx Map Bind Group", .layout = g_map.bindLayout, .entryCount = 1, .entries = &entry};
+    g_map.group = ctx.device.CreateBindGroup(&bd);
+    g_map.groupBuffer = ctx.uniformBuffer.Get();
+  }
+  pass.SetPipeline(pipeline);
+  pass.SetBindGroup(0, g_map.group, 1, &p.uniform.offset);
+  pass.SetVertexBuffer(0, ctx.vertexBuffer, p.inst.offset, p.inst.size);
+  if (p.dstAlpha != UINT32_MAX) {
+    const wgpu::Color constant{0.f, 0.f, 0.f, p.dstAlpha / 255.f};
+    pass.SetBlendConstant(&constant);
+  }
+  pass.Draw(12, p.count);
+}
+
+uint32_t map_refusals = 0;
+void map_refuse(const char* why) {
+  if (map_refusals < 8) {
+    ++map_refusals;
+    std::fprintf(stderr, "map: GPU path refused (%s); this flush is drawn the CPU way\n", why);
+  }
+}
+} // namespace
+
+extern "C" bool aurora_map_draw(const AuroraMapInstance* instances, uint32_t count) {
+  using namespace aurora::gx;
+  fifo::drain();
+  if (count == 0) {
+    return true;
+  }
+  if (g_map.drawType == gfx::InvalidDrawType) {
+    g_map.drawType = gfx::register_draw_type(gfx::DrawTypeDescriptor{.label = "mp2-nx Map", .draw = map_draw_cb});
+    if (g_map.drawType == gfx::InvalidDrawType) {
+      map_refuse("the draw type could not be registered");
+      return false;
+    }
+  }
+  if (!gfx::has_render_pass()) {
+    map_refuse("no render pass");
+    return false;
+  }
+  if (gfx::scene_hdr_pass_active()) {
+    map_refuse("the HDR scene pass");
+    return false;
+  }
+  const bool hasAlpha = efb_has_alpha(g_gxState.pixelFmt);
+  const uint32_t dstAlpha = hasAlpha && g_gxState.alphaUpdate ? g_gxState.dstAlpha : UINT32_MAX;
+  // dst_alpha_mode's choice, for the map's state
+  uint32_t alphaMode = 0;
+  if (dstAlpha != UINT32_MAX && dstAlpha != 0) {
+    const auto usesSourceAlpha = [](GXBlendFactor factor) {
+      return factor == GX_BL_SRCALPHA || factor == GX_BL_INVSRCALPHA;
+    };
+    const bool needsSourceAlpha =
+        g_gxState.colorUpdate && g_gxState.blendMode == GX_BM_BLEND &&
+        (usesSourceAlpha(g_gxState.blendFacSrc) || usesSourceAlpha(g_gxState.blendFacDst));
+    if (!needsSourceAlpha) {
+      alphaMode = 1;
+    } else if (webgpu::g_dualSourceBlendingSupported) {
+      alphaMode = 2;
+    } else {
+      map_refuse("a constant destination alpha under a source-alpha blend, and no dual-source blending");
+      return false;
+    }
+  }
+  static uint32_t saidModes = 0;
+  if ((saidModes & (1u << alphaMode)) == 0) {
+    saidModes |= 1u << alphaMode;
+    std::fprintf(stderr,
+                 "map: GPU path: a flush with dst alpha %d (alpha mode %u), blend mode %d (src %d, dst %d), colour "
+                 "update %d, alpha update %d\n",
+                 dstAlpha == UINT32_MAX ? -1 : int(dstAlpha), alphaMode, int(g_gxState.blendMode),
+                 int(g_gxState.blendFacSrc), int(g_gxState.blendFacDst), int(g_gxState.colorUpdate),
+                 int(g_gxState.alphaUpdate));
+  }
+  if (g_gxState.fog.type != GX_FOG_NONE) {
+    static bool said = false;
+    if (!said) {
+      said = true;
+      std::fprintf(stderr, "map: GPU path: GX fog is on (type %d) and the map draw is not fogged\n",
+                   int(g_gxState.fog.type));
+    }
+  }
+  const auto blendFactor = [hasAlpha](GXBlendFactor factor) {
+    if (!hasAlpha && factor == GX_BL_DSTALPHA) {
+      return GX_BL_ONE;
+    }
+    if (!hasAlpha && factor == GX_BL_INVDSTALPHA) {
+      return GX_BL_ZERO;
+    }
+    return factor;
+  };
+  const wgpu::BlendState blend = to_blend_state(g_gxState.blendMode, blendFactor(g_gxState.blendFacSrc),
+                                                blendFactor(g_gxState.blendFacDst), g_gxState.blendOp, dstAlpha, alphaMode == 2);
+  const GXCullMode cull = g_gxState.cullMode;
+  const auto [polygonOffset, polygonOffsetScale] = polygon_offset_for_cull_mode(cull);
+  MapPayload p{};
+  p.key.colorOp = uint32_t(blend.color.operation);
+  p.key.colorSrc = uint32_t(blend.color.srcFactor);
+  p.key.colorDst = uint32_t(blend.color.dstFactor);
+  p.key.alphaOp = uint32_t(blend.alpha.operation);
+  p.key.alphaSrc = uint32_t(blend.alpha.srcFactor);
+  p.key.alphaDst = uint32_t(blend.alpha.dstFactor);
+  p.key.writeMask = uint32_t(to_write_mask(g_gxState.colorUpdate, hasAlpha && g_gxState.alphaUpdate));
+  p.key.depthWrite = g_gxState.depthCompare && g_gxState.depthUpdate ? 1 : 0;
+  p.key.depthCompare = uint32_t(g_gxState.depthCompare ? to_compare_function(g_gxState.depthFunc)
+                                                       : wgpu::CompareFunction::Always);
+  p.key.cull = uint32_t(to_primitive_state(cull).cullMode);
+  p.key.depthBias = round_away_from_zero<int32_t>((UseReversedZ ? -1.0f : 1.0f) * polygonOffset);
+  p.key.slope = (UseReversedZ ? -1.0f : 1.0f) * polygonOffsetScale;
+  p.key.clamp = webgpu::g_hasCoreFeatures ? g_gxState.clamp : 0.0f;
+  p.key.alphaMode = alphaMode;
+  p.dstAlpha = dstAlpha;
+
+  MapUniform u{};
+  const auto& pos = g_gxState.pnMtx[g_gxState.currentPnMtx].pos;
+  std::memcpy(u.pn, &pos, sizeof(u.pn));
+  auto proj = g_gxState.proj;
+  if constexpr (UseReversedZ) {
+    proj.m2 = proj.m2 * Vec4<float>{-1.f, -1.f, -1.f, -1.f};
+  } else {
+    proj.m2 = proj.m2 + proj.m3;
+  }
+  static_assert(sizeof(proj) == sizeof(u.proj));
+  std::memcpy(u.proj, &proj, sizeof(u.proj));
+  u.vp[0] = g_gxState.renderViewport.width;
+  u.vp[1] = g_gxState.renderViewport.height;
+  u.vp[2] = g_gxState.logicalViewport.width;
+  u.vp[3] = g_gxState.logicalViewport.height;
+  u.misc[0] = cull != GX_CULL_NONE ? 1.f : 0.f;
+
+  p.inst = gfx::push_verts(reinterpret_cast<const uint8_t*>(instances), size_t(count) * sizeof(AuroraMapInstance), 4);
+  if (gfx::overflowed(p.inst) || p.inst.size == 0) {
+    map_refuse("the frame's vertex buffer is full");
+    return false;
+  }
+  p.uniform = gfx::push_uniform(reinterpret_cast<const uint8_t*>(&u), sizeof(u));
+  if (gfx::overflowed(p.uniform) || p.uniform.size == 0) {
+    map_refuse("the frame's uniform buffer is full");
+    return false;
+  }
+  p.count = count;
+  if (!gfx::push_custom_draw(g_map.drawType, &p, sizeof(p))) {
+    map_refuse("push_custom_draw failed");
+    return false;
+  }
+  return true;
+}
