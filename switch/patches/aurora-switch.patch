+#if defined(__SWITCH__)
+// Horizon gives an application cores 0, 1 and 2 and keeps core 3 for the system. Each
+// kind of thread gets a set of cores it may run on and the one it starts on:
+//
+//   Logic    cores 0-1, starts on 0   the game thread
+//   Fifo     core 1                   GX to WebGPU translation. The game thread
+//                                     blocks on this worker every frame, so
+//                                     whatever shares its core is taken out of
+//                                     the frame.
+//   Render   core 2                   only submits command buffers, mostly idle
+//   Compile  core 2                   shader compilation, at low priority so it
+//                                     fills the gaps on the render core. It must
+//                                     never share the FIFO core: a compile there
+//                                     would cost the frame twice, once for the
+//                                     compile and once for the translation it
+//                                     displaced.
+struct CorePlacement {
+  uint32_t allowed;  // bit n set: may run on core n
+  int32_t start;
+};
+
+std::optional<CorePlacement> switch_placement(Affinity affinity) noexcept {
+  switch (affinity) {
+  case Affinity::Logic:
+    return CorePlacement{0b011, 0};
+  case Affinity::Fifo:
+    return CorePlacement{0b010, 1};
+  case Affinity::Render:
+  case Affinity::Compile:
+    return CorePlacement{0b100, 2};
+  default:
+    return std::nullopt;
+  }
+}
+#endif
+
 void pin_shared_cache() noexcept {
   std::lock_guard lock{sDomainMutex};
   if (!sDomainConfigured) {
@@ -290,9 +330,60 @@ void set_current(const Options& options) noexcept {
   }
 
   SDL_SetCurrentThreadPriority(to_sdl_priority(options.priority));
+#if defined(__SWITCH__)
+  if (const auto placement = switch_placement(options.affinity)) {
+    // The kernel refuses a mask that reaches outside the cores this process owns.
+    // That is not fatal: an unpinned thread still runs, wherever it is put.
+    ::svcSetThreadCoreMask(::threadGetCurHandle(), placement->start, placement->allowed);
+  } else if (options.affinity == Affinity::SharedCache) {
+    pin_shared_cache();
+  }
+#else
   if (options.affinity == Affinity::SharedCache) {
     pin_shared_cache();
   }
+#endif
 }
 
+#if defined(__SWITCH__)
+struct LargeStackThread::Impl {
+  pthread_t handle{};
+  std::function<void()> body;
+};
+
+bool LargeStackThread::start(size_t stackBytes, std::function<void()> body) {
+  if (mImpl != nullptr) {
+    return false;
+  }
+  auto impl = std::make_unique<Impl>();
+  impl->body = std::move(body);
+
+  pthread_attr_t attributes;
+  pthread_attr_init(&attributes);
+  pthread_attr_setstacksize(&attributes, stackBytes);
+  const int created = pthread_create(
+      &impl->handle, &attributes,
+      [](void* self) -> void* {
+        static_cast<Impl*>(self)->body();
+        return nullptr;
+      },
+      impl.get());
+  pthread_attr_destroy(&attributes);
+  if (created != 0) {
+    return false;
+  }
+  mImpl = impl.release();
+  return true;
+}
+
+void LargeStackThread::join() noexcept {
+  if (mImpl == nullptr) {
+    return;
+  }
+  pthread_join(mImpl->handle, nullptr);
+  delete mImpl;
+  mImpl = nullptr;
+}
+#endif
+
 } // namespace aurora::thread
