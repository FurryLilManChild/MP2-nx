+  }
+  const auto& p = g_gxState.proj;
+  const aurora::Vec4<float>* rows4[4] = {&p.m0, &p.m1, &p.m2, &p.m3};
+  for (int r = 0; r < 4; ++r) {
+    for (int c = 0; c < 4; ++c) {
+      proj[r * 4 + c] = rows4[r]->m[c];
+    }
+  }
+  vp[0] = g_gxState.renderViewport.width;
+  vp[1] = g_gxState.renderViewport.height;
+  vp[2] = g_gxState.logicalViewport.width;
+  vp[3] = g_gxState.logicalViewport.height;
