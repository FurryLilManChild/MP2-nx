+constexpr const char* MapSource = R"(
+struct U {
+  pn: array<vec4f, 3>,
+  proj: array<vec4f, 4>,
+  vp: vec4f,
+  misc: vec4f,
+};
+@group(0) @binding(0) var<uniform> u: U;
+
+struct VIn {
+  @builtin(vertex_index) vi: u32,
+  @location(0) p0: vec3f,
+  @location(1) p1: vec3f,
+  @location(2) p2: vec3f,
+  @location(3) color: vec4f,
+  @location(4) kind: f32,
+};
+struct VOut {
+  @builtin(position) pos: vec4f,
+  @location(0) color: vec4f,
+};
+
+fn to_clip(p: vec3f) -> vec4f {
+  let v = vec4f(p, 1.0);
+  let mv = vec4f(dot(v, u.pn[0]), dot(v, u.pn[1]), dot(v, u.pn[2]), 1.0);
+  return vec4f(dot(mv, u.proj[0]), dot(mv, u.proj[1]), dot(mv, u.proj[2]), dot(mv, u.proj[3]));
+}
+
+@vertex
+fn vs_main(in: VIn) -> VOut {
+  var out: VOut;
+  out.color = in.color;
+  out.pos = vec4f(0.0, 0.0, 0.0, 1.0);
+  if (in.kind < 0.0) {
+    // a fill triangle: vertices 0..2, the rest collapse to a point (no pixels)
+    if (in.vi < 3u) {
+      var p = in.p0;
+      if (in.vi == 1u) { p = in.p1; }
+      if (in.vi == 2u) { p = in.p2; }
+      out.pos = to_clip(p);
+    }
+    return out;
+  }
+  // a segment: Aurora's quad (0, 1, 3), (3, 2, 0); vertices 6..11 the same in reverse when culling is on
+  var k = in.vi;
+  if (k >= 6u) {
+    if (u.misc.x == 0.0) {
+      return out;
+    }
+    k = 11u - k;
+  }
+  var order = array<u32, 6>(0u, 1u, 3u, 3u, 2u, 0u);
+  let q = order[k];
+  let clip_a = to_clip(in.p0);
+  let clip_b = to_clip(in.p1);
+  let ndc_a = clip_a.xy / clip_a.w;
+  let ndc_b = clip_b.xy / clip_b.w;
+  let render = u.vp.xy;
+  let viewport_scale = render / max(u.vp.zw, vec2f(1.0));
+  let delta_px = (ndc_b - ndc_a) / 2.0 * render;
+  let dir_px = select(vec2f(1.0, 0.0), normalize(delta_px), dot(delta_px, delta_px) > 1e-10);
+  let perp_px = vec2f(-dir_px.y, dir_px.x);
+  let line_width = in.kind * min(viewport_scale.x, viewport_scale.y);
+  let offset_px = perp_px * (line_width / 2.0) * select(-1.0, 1.0, (q & 1u) != 0u);
+  let offset_ndc = (offset_px * 2.0) / render;
+  let base = select(clip_a, clip_b, q >= 2u);
+  out.pos = vec4f(base.xy + offset_ndc * base.w, base.zw);
+  return out;
+}
+
+@fragment
+fn fs_main(in: VOut) -> @location(0) vec4f {
+  return in.color;
+}
+)";
