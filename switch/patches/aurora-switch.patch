+    return;
+  }
+  if (!g_recording) {
+    // a capture starts at a frame's first pass (index 0), so it holds the whole frame
+    if (g_requestDir.empty() || !g_dir.empty() || g_toMap || passIndex != 0) {
+      return;
+    }
