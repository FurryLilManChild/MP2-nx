+#if defined(__SWITCH__)
+// Horizon gives an application cores 0, 1 and 2 and keeps core 3 for the system. Each
+// kind of thread gets a set of cores it may run on and the one it starts on:
+//
+//   Logic    cores 0-1, starts on 0   the game thread
+//   Fifo     core 1                   GX to WebGPU translation. The game thread
+//                                     blocks on this worker every frame, so
+//                                     whatever shares its core is taken out of
+//                                     the frame.
+//   Render   core 2                   only submits command buffers, mostly idle
+//   Compile  core 2                   shader compilation, at low priority so it
+//                                     fills the gaps on the render core. It must
+//                                     never share the FIFO core: a compile there
+//                                     would cost the frame twice, once for the
+//                                     compile and once for the translation it
+//                                     displaced.
+struct CorePlacement {
+  uint32_t allowed;  // bit n set: may run on core n
+  int32_t start;
+};
+
+std::optional<CorePlacement> switch_placement(Affinity affinity) noexcept {
+  switch (affinity) {
+  case Affinity::Logic:
+    return CorePlacement{0b011, 0};
+  case Affinity::Fifo:
+    return CorePlacement{0b010, 1};
+  case Affinity::Render:
+  case Affinity::Compile:
+    return CorePlacement{0b100, 2};
+  default:
+    return std::nullopt;
+  }
+}
+#endif
