+// ---- mp2-nx: the map screen's native draw (aurora/map_draw.h; CMapArea.cpp builds the instances)
+// The map's surfaces and outlines in one GPU draw, nothing per vertex on the CPU. Each instance is a fill
+// triangle or an outline segment, in world space, with its colour; the vertex shader transforms it with the GX
+// position matrix and projection in force, and widens a segment into the screen-space quad Aurora's GX line
+// shader would draw (gx/shader.cpp, lineMode 1). The draw sits in the EFB pass where it was recorded, with the
+// GX blend, depth and cull state of that moment, so it composites as the GX draws it replaces.
+// Fills are culled by the pipeline as GX would cull them. Aurora draws GX lines unculled; a segment's quad
+// therefore goes in both windings when culling is on (one survives) and in one when it is off, which is what
+// the CPU path this replaces did (and what showed the same image).
+#include <aurora/gfx.hpp>
+#include <aurora/gfx.h>
+#include <array>
+#include <chrono>
+#include <string>
+#include <cstdio>
+#include <vector>
+
+namespace {
+using namespace aurora;
+using namespace aurora::gx;
+
+static_assert(sizeof(AuroraMapInstance) == 44);
+
+struct MapUniform {
+  float pn[12];   // the position matrix's rows
+  float proj[16]; // the projection's rows, z as GX draws use it (shader_info.cpp)
+  float vp[4];    // render viewport w, h; logical viewport w, h
+  float misc[4];  // x: both windings for the segments (culling is on)
+};
+static_assert(sizeof(MapUniform) == 144);
+
+struct MapPipeKey {
+  uint32_t colorOp, colorSrc, colorDst, alphaOp, alphaSrc, alphaDst;
+  uint32_t writeMask, depthWrite, depthCompare, cull;
+  int32_t depthBias;
+  float slope, clamp;
+  uint32_t alphaMode; // 0 the colour's alpha, 1 alpha 1 (a constant dst alpha), 2 dual source (it, and the colour's alpha as the second source)
+  bool operator==(const MapPipeKey& o) const { return std::memcmp(this, &o, sizeof(*this)) == 0; }
