+            SQLITE_OMIT_LOAD_EXTENSION=1)
+    endif()
+    if(MP2NX_APP_NAME STREQUAL "mp2-nx")
+        set(_mp2nx_title "Metroid Prime 2: Echoes")
+    else()
+        set(_mp2nx_title "Metroid Prime 2: Echoes (${MP2NX_APP_NAME})")
+    endif()
