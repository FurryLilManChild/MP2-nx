+void CMapArea::CMapAreaSurface::DrawNative(const CTransform4f& xf, const CVector3f* verts,
+                                           const CColor& surfColor, const CColor& lineColor,
+                                           float lineWidth) const {
+  const unsigned long long queueStart = native_now();
+  struct QueueTimer {
+    unsigned long long t0;
+    ~QueueTimer() { gStats.queue += native_now() - t0; }
+  } queueTimer = {queueStart};
+  const bool hasSurfAlpha = surfColor.GetAlpha() > 0.0f;
+  const bool hasLineAlpha = lineColor.GetAlpha() > 0.0f;
+  const int numSurfaces = *mSurfOffset;
+  const int numOutlines = *mOutlineOffset;
+  if (hasSurfAlpha) {
+    const GXColor c = surfColor.GetGXColor();
+    gLastK = c;
+    const int* surface = &mSurfOffset[1];
+    for (int i = 0; i < numSurfaces; ++i) {
+      const GXPrimitive prim = static_cast< GXPrimitive >(*surface++);
+      const int n = *surface++;
+      const uchar* d = reinterpret_cast< const uchar* >(surface);
+      surface += ((n + 3) & ~3) / 4;
+      // The triangles Aurora makes of each primitive (gx/command_processor.cpp), in its order and winding.
+      if (prim == GX_TRIANGLES) {
+        for (int v = 0; v + 3 <= n; v += 3) {
+          push_tri(xf, verts, d[v], d[v + 1], d[v + 2], c);
+        }
+      } else if (prim == GX_TRIANGLESTRIP && n >= 3) {
+        push_tri(xf, verts, d[0], d[1], d[2], c);
+        for (int v = 3; v < n; ++v) {
+          if ((v & 1) == 0) {
+            push_tri(xf, verts, d[v - 2], d[v - 1], d[v], c);
+          } else {
+            push_tri(xf, verts, d[v - 1], d[v - 2], d[v], c);
+          }
+        }
+      } else if (prim == GX_TRIANGLEFAN && n >= 3) {
+        push_tri(xf, verts, d[0], d[1], d[2], c);
+        for (int v = 3; v < n; ++v) {
+          push_tri(xf, verts, d[0], d[v - 1], d[v], c);
+        }
+      } else if (prim == GX_QUADS) {
+        for (int v = 0; v + 4 <= n; v += 4) {
+          push_tri(xf, verts, d[v], d[v + 1], d[v + 2], c);
+          push_tri(xf, verts, d[v + 2], d[v + 3], d[v], c);
+        }
+      }
+    }
+  }
+  if (hasLineAlpha) {
+    const bool thickLine = lineWidth > 1.f;
+    for (int j = 0; j < (thickLine ? 1 : 0) + 1; ++j) {
+      float width = -1.f;
+      if (thickLine) {
+        // CGraphics::SetLineWidth: GX keeps the width in sixths of a pixel, in a byte
+        width = static_cast< float >(static_cast< uchar >((lineWidth - j) * 6.f)) / 6.f;
+        gLastSetWidth = lineWidth - j;
+      }
+      const GXColor c = lineColor.WithAlphaModulatedBy(thickLine ? 0.5f : 1.0f).GetGXColor();
+      gLastK = c;
+      const int* outline = &mOutlineOffset[1];
+      for (int i = 0; i < numOutlines; ++i) {
+        const int n = *outline++;
+        const uchar* d = reinterpret_cast< const uchar* >(outline);
+        outline += ((n + 3) & ~3) / 4;
