+}  // namespace
+
+// The map's path. Build 3 measured the GPU path at 60 fps where GX ran at 24 (2026-11-09), so from build 4 it is
+// the only one by default. MP2_NATIVE_MAP (deko3d_env.txt): 0 the GX path, ab the two taking turns every 6 s
+// (an A/B in one sitting, each switch logged on stderr), anything else or unset the GPU path.
+namespace {
+int gPinned = -2;            // -2 unread, -1 alternate, 0 GX, 1 native
+bool gAbNative = true;
+unsigned long long gAbSince = 0;
+unsigned long long gAbLastSeen = 0;
+}  // namespace
+
+bool CMapArea::NativeMapEnabled() {
+  if (gPinned == -2) {
+    const char* e = std::getenv("MP2_NATIVE_MAP");
+    gPinned = e != nullptr && e[0] == 'a' && e[1] == 'b' ? -1 : (e != nullptr && *e == '0' ? 0 : 1);
+    std::fprintf(stderr, "map: %s\n",
+                 gPinned < 0 ? "the GPU and GX map paths alternate every 6 s while the map is open (MP2_NATIVE_MAP=ab)"
+                             : (gPinned ? "the GPU map path" : "the GX map path (MP2_NATIVE_MAP=0)"));
+  }
+  if (gPinned >= 0) {
+    return gPinned == 1;
+  }
+  const unsigned long long now = native_now();
+  // a map closed for more than a second opens on the native path again, with a new turn
+  if (gAbSince == 0 || now - gAbLastSeen > 1000000000ull) {
+    gAbNative = true;
+    gAbSince = now;
+    std::fprintf(stderr, "map: A/B: the map opened, NATIVE path\n");
+  } else if (now - gAbSince >= 6000000000ull) {
+    gAbNative = !gAbNative;
+    gAbSince = now;
+    std::fprintf(stderr, "map: A/B: now the %s path\n", gAbNative ? "NATIVE" : "GX (old)");
+  }
+  gAbLastSeen = now;
+  return gAbNative;
+}
