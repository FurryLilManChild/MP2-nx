+      gOut.push_back(corner[kOrder[i]]);
+    }
+    if (bothWindings) {
+      for (int i = 5; i >= 0; --i) {
+        gOut.push_back(corner[kOrder[i]]);
+      }
+    }
+  }
+  const GXVtxDescList desc[3] = {
+      {GX_VA_POS, GX_DIRECT},
+      {GX_VA_CLR0, GX_DIRECT},
+      {GX_VA_NULL, GX_NONE},
+  };
+  CGX::SetVtxDescv(desc);
+  GXSetVtxAttrFmt(GX_VTXFMT1, GX_VA_POS, GX_POS_XYZ, GX_F32, 0);
+  GXSetVtxAttrFmt(GX_VTXFMT1, GX_VA_CLR0, GX_CLR_RGBA, GX_RGBA8, 0);
+  CGX::SetTevOrder(GX_TEVSTAGE0, GX_TEXCOORD_NULL, GX_TEXMAP_NULL, GX_COLOR0A0);
+  CGX::SetTevColorIn(GX_TEVSTAGE0, GX_CC_ZERO, GX_CC_ZERO, GX_CC_ZERO, GX_CC_RASC);
+  CGX::SetTevAlphaIn(GX_TEVSTAGE0, GX_CA_ZERO, GX_CA_ZERO, GX_CA_ZERO, GX_CA_RASA);
+  const uint kChunk = 3 * 8190;
+  for (uint at = 0; at < gOut.size(); at += kChunk) {
+    const uint n = CMath::Min< uint >(kChunk, static_cast< uint >(gOut.size() - at));
+    CGX::Begin(GX_TRIANGLES, GX_VTXFMT1, n);
+    for (uint i = at; i < at + n; ++i) {
+      const NativeVtx& v = gOut[i];
+      GXPosition3f32(v.x, v.y, v.z);
+      GXColor4u8(v.c.r, v.c.g, v.c.b, v.c.a);
+    }
+    CGX::End();
+  }
+}
+}  // namespace
+
+void CMapArea::FlushNativeBatch() {
+  if (gInst.empty()) {
+    return;
+  }
+  // The batch is in world space: the model matrix is the identity, so the position matrix is the view.
+  const unsigned long long flushStart = native_now();
+  CGraphics::SetIdentityModelMatrix();
+  float pn[12], proj[16], vp[4], gxWidth = 1.f;
+  int cull = GX_CULL_NONE;
+  aurora_gx_drawing_state(pn, proj, vp, &gxWidth, &cull);  // (drains the FIFO)
+  for (size_t k = 0; k < gGxWidth.size(); ++k) {
+    gInst[gGxWidth[k]].kind = gxWidth;
+  }
+  const unsigned long long stateDone = native_now();
+  gStats.state += stateDone - flushStart;
+  gStats.flushes++;
+  uint fills = 0;
+  for (size_t k = 0; k < gInst.size(); ++k) {
+    fills += gInst[k].kind < 0.f ? 1 : 0;
+  }
+  gStats.fills += fills;
+  gStats.segs += gInst.size() - fills;
+
+  const bool gpu = aurora_map_draw(gInst.data(), static_cast< uint32_t >(gInst.size()));
+  const unsigned long long handoffDone = native_now();
+  gStats.handoff += handoffDone - stateDone;
+  if (!gpu) {
+    draw_cpu(pn, proj, vp, cull);
+    gStats.cpuFlushes++;
+    gStats.fallback += native_now() - handoffDone;
+  }
+  // The state the per-primitive path leaves: its material, the last K colour and line width.
+  CMapAreaSurface::SetupGXMaterial();
+  CGX::SetTevKColor(GX_KCOLOR0, gLastK);
+  if (gLastSetWidth >= 0.f) {
+    CGraphics::SetLineWidth(gLastSetWidth, kTO_One);
+  }
+  static int reports = 0;
+  if (reports < 3) {
+    ++reports;
+    std::fprintf(stderr, "map: native batch: %u fill triangles, %u outline segments, %s\n", fills,
+                 static_cast< uint >(gInst.size() - fills), gpu ? "one GPU draw" : "drawn the CPU way");
+  }
+  gInst.clear();
+  gGxWidth.clear();
+  gLastSetWidth = -1.f;
+}
+#endif
+
+#ifdef TARGET_PC
+// The map A/B label (switch_menu.cpp): the path in use and the map's draw time, smoothed over about 0.3 s.
+namespace {
+float gLabelDrawMs = 0.f;
+unsigned long long gLabelSeen = 0;
+}  // namespace
+
+extern "C" bool mp2nx_map_ab_state(int* native, float* drawMs) {
+  if (gLabelSeen == 0 || native_now() - gLabelSeen > 500000000ull) {
+    return false;
+  }
+  *native = (gPinned >= 0 ? gPinned == 1 : gAbNative) ? 1 : 0;
+  *drawMs = gLabelDrawMs;
+  return true;
+}
+
+void CMapArea::NativeFrameDone(unsigned long long drawNs) {
+  static bool lastNative = true;
+  const bool native = gPinned >= 0 ? gPinned == 1 : gAbNative;
+  gLabelDrawMs = gLabelSeen == 0 || native != lastNative ? float(drawNs / 1e6)
+                                                         : gLabelDrawMs * 0.9f + float(drawNs / 1e6) * 0.1f;
+  gLabelSeen = native_now();
+  if (native != lastNative) {
+    gStats = NativeStats();  // (a window holds one path only)
+    gStatsWindow = 0;
+    lastNative = native;
+  }
+  gStats.frames++;
+  gStats.draw += drawNs;
+  const unsigned long long now = native_now();
+  if (gStatsWindow == 0) {
+    gStatsWindow = now;
+  }
+  if (now - gStatsWindow < 10000000000ull || gStats.frames == 0) {
+    return;
+  }
+  const double n = double(gStats.frames);
+  if (native) {
+    std::fprintf(stderr, "map: NATIVE (GPU) path, per frame (%llu frames): the sorted map draw %.2f ms; of it queueing %.2f ms, "
+                 "%.1f flushes taking the GX state %.2f ms (with a FIFO drain), the hand-off to the GPU %.2f ms, the CPU "
+                 "fallback %.2f ms (%llu flushes); %.0f fill triangles and %.0f segments\n",
+                 gStats.frames, gStats.draw / n / 1e6, gStats.queue / n / 1e6, gStats.flushes / n, gStats.state / n / 1e6,
+                 gStats.handoff / n / 1e6, gStats.fallback / n / 1e6, gStats.cpuFlushes, gStats.fills / n, gStats.segs / n);
+  } else {
+    std::fprintf(stderr, "map: GX (old) path, per frame (%llu frames): the sorted map draw %.2f ms\n", gStats.frames,
+                 gStats.draw / n / 1e6);
+  }
+  gStats = NativeStats();
+  gStatsWindow = now;
+}
+#endif
