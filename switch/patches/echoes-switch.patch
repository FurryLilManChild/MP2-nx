+namespace {
+// Build 1's CPU path, kept for a flush Aurora refuses: the triangles as they are, the segments widened into
+// Aurora's quads here and taken back to world space, written through GX.
+void draw_cpu(const float pn[12], const float proj[16], const float vp[4], int cull) {
+  float pn4[16] = {pn[0], pn[1], pn[2], pn[3], pn[4], pn[5], pn[6], pn[7], pn[8], pn[9], pn[10], pn[11], 0.f, 0.f, 0.f, 1.f};
+  float projInv[16], pnInv[16];
+  const bool canLines = invert4(proj, projInv) && invert4(pn4, pnInv);
+  const float renderW = vp[0] > 0.f ? vp[0] : 1.f, renderH = vp[1] > 0.f ? vp[1] : 1.f;
+  const float scale = CMath::Min(renderW / CMath::Max(vp[2], 1.f), renderH / CMath::Max(vp[3], 1.f));
+  const bool bothWindings = cull != GX_CULL_NONE;
