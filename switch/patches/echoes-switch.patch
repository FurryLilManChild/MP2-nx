+        for (int v = 0; v + 1 < n; ++v) {
+          const CVector3f next = xf * verts[d[v + 1]];
+          AuroraMapInstance in;
+          put3(in.p0, prev);
+          put3(in.p1, next);
+          in.p2[0] = in.p2[1] = in.p2[2] = 0.f;
+          in.color[0] = c.r;
+          in.color[1] = c.g;
+          in.color[2] = c.b;
+          in.color[3] = c.a;
+          in.kind = width;
+          if (width < 0.f) {
