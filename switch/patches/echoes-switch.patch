+        target_link_libraries(metroid_prime2_port PRIVATE mp2nx_deko)
+        target_link_options(metroid_prime2_port PRIVATE ${MP2NX_DEKO3D_WRAP_FLAGS})
+        target_compile_definitions(mp_port_audio PRIVATE MP2NX_DEKO3D=1)
+    endif()
+    set_target_properties(metroid_prime2_port PROPERTIES OUTPUT_NAME ${MP2NX_APP_NAME})
+    # mp2-nx: the build stamp, written again on every build (switch/cmake/mp2nx_build_id.cmake)
+    add_custom_target(mp2nx_build_id ALL
+        COMMAND ${CMAKE_COMMAND} -DOUT=${CMAKE_BINARY_DIR}/mp2nx_build_id.c
+            -DNUMBER_FILE=${CMAKE_BINARY_DIR}/mp2nx_build_number.txt -DROOT=${MP2NX_ROOT}
+            -P ${MP2NX_ROOT}/switch/cmake/mp2nx_build_id.cmake
+        BYPRODUCTS ${CMAKE_BINARY_DIR}/mp2nx_build_id.c
+        COMMENT "mp2-nx build stamp")
+    target_sources(metroid_prime2_port PRIVATE ${CMAKE_BINARY_DIR}/mp2nx_build_id.c)
+    add_dependencies(metroid_prime2_port mp2nx_build_id)
