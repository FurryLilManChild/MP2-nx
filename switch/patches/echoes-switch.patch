+    if (len2 > 1e-10f) {
+      const float inv = 1.f / CMath::SqrtF(len2);
+      dirX = dx * inv;
+      dirY = dy * inv;
+    }
+    const float lw = s.kind * scale;
+    const float offX = -dirY * (lw / 2.f) * 2.f / renderW;
+    const float offY = dirX * (lw / 2.f) * 2.f / renderH;
+    NativeVtx corner[4];
+    for (int q = 0; q < 4; ++q) {
+      const float* base = clip[q >= 2 ? 1 : 0];
+      const float sign = (q & 1) != 0 ? 1.f : -1.f;
+      const float c4[4] = {base[0] + offX * sign * base[3], base[1] + offY * sign * base[3], base[2], base[3]};
+      float h[4];
+      for (int i = 0; i < 4; ++i) {
+        h[i] = projInv[i * 4] * c4[0] + projInv[i * 4 + 1] * c4[1] + projInv[i * 4 + 2] * c4[2] + projInv[i * 4 + 3] * c4[3];
+      }
+      const float iw = h[3] != 0.f ? 1.f / h[3] : 1.f;
+      const float m[3] = {h[0] * iw, h[1] * iw, h[2] * iw};
+      NativeVtx v;
+      v.x = pnInv[0] * m[0] + pnInv[1] * m[1] + pnInv[2] * m[2] + pnInv[3];
+      v.y = pnInv[4] * m[0] + pnInv[5] * m[1] + pnInv[6] * m[2] + pnInv[7];
+      v.z = pnInv[8] * m[0] + pnInv[9] * m[1] + pnInv[10] * m[2] + pnInv[11];
