 constexpr int64_t kProcessJumpKb = 64 * 1024;
 constexpr int64_t kSystemJumpKb = 128 * 1024;
 
+#if defined(__SWITCH__)
+// mp2-nx: Horizon has no /proc. libnx hands the whole heap to the process at startup
+// (__nx_heap_size 0), so svcGetInfo's used memory is always nearly all of it; what counts is how
+// much of that heap malloc has handed out (GPU memory included: NVK allocates from it).
+int64_t ProcessKb() { return static_cast< int64_t >(mallinfo().uordblks / 1024); }
+
+struct SystemMemory {
+  int64_t totalKb = -1;
+  int64_t availableKb = -1;
+};
+
+SystemMemory ReadSystem() {
+  SystemMemory memory;
+  const int64_t heapKb = static_cast< int64_t >((fake_heap_end - fake_heap_start) / 1024);
+  memory.totalKb = heapKb;
+  memory.availableKb = heapKb - ProcessKb();
+  return memory;
+}
+#else
 // Resident size of this process, in KiB; -1 when /proc can't say.
 int64_t ProcessKb() {
   FILE* file = std::fopen("/proc/self/statm", "r");
@@ -61,6 +85,7 @@ SystemMemory ReadSystem() {
   std::fclose(file);
   return memory;
 }
+#endif
 
