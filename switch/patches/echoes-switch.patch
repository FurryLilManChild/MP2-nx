+    const GXColor col = {s.color[0], s.color[1], s.color[2], s.color[3]};
+    if (s.kind < 0.f) {
+      const float* ps[3] = {s.p0, s.p1, s.p2};
+      for (int i = 0; i < 3; ++i) {
+        NativeVtx v = {ps[i][0], ps[i][1], ps[i][2], col};
+        gOut.push_back(v);
+      }
+      continue;
+    }
+    if (!canLines) {
+      continue;
+    }
+    float clip[2][4];
+    const float* ends[2] = {s.p0, s.p1};
+    for (int e = 0; e < 2; ++e) {
+      const float wx = ends[e][0], wy = ends[e][1], wz = ends[e][2];
+      const float mv[4] = {pn[0] * wx + pn[1] * wy + pn[2] * wz + pn[3], pn[4] * wx + pn[5] * wy + pn[6] * wz + pn[7],
+                           pn[8] * wx + pn[9] * wy + pn[10] * wz + pn[11], 1.f};
+      for (int i = 0; i < 4; ++i) {
+        clip[e][i] = proj[i * 4] * mv[0] + proj[i * 4 + 1] * mv[1] + proj[i * 4 + 2] * mv[2] + proj[i * 4 + 3];
+      }
+    }
+    const float ndcAx = clip[0][0] / clip[0][3], ndcAy = clip[0][1] / clip[0][3];
+    const float ndcBx = clip[1][0] / clip[1][3], ndcBy = clip[1][1] / clip[1][3];
