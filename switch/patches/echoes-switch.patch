diff --git a/CMakeLists.txt b/CMakeLists.txt
index ef1c8c60d..4d211c661 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1031,7 +1031,9 @@ elseif(CMAKE_LINK_GROUP_USING_RESCAN_SUPPORTED OR CMAKE_CXX_LINK_GROUP_USING_RES
         # the whole point is naming the function that faulted. This is the only place it is
         # needed: the decomp build links no platform code and the gate's port build inherits
         # it from here. Android has no `execinfo`/`backtrace`, so it is desktop-only.
-        target_link_options(metroid_prime2_port PRIVATE -rdynamic)
+        if(NOT CMAKE_SYSTEM_NAME STREQUAL "NintendoSwitch")
+            target_link_options(metroid_prime2_port PRIVATE -rdynamic)
+        endif()
     endif()
 elseif(APPLE)
     # ld64 searches every archive again until nothing new resolves, so the cycle needs no
@@ -1105,3 +1107,38 @@ if(NOT ANDROID AND NOT IOS)
             DESTINATION ${CMAKE_INSTALL_DATADIR}/metainfo)
     endif()
 endif()
+
+# mp2-nx: the Nintendo Switch build (https://github.com/FurryLilManChild/mp2-nx). Its
+# dependencies are decided by switch/cmake/mp2_switch_deps.cmake, injected ahead of this
+# file; here the Horizon start-up, the low-address REL arena and the NRO are added.
+if(CMAKE_SYSTEM_NAME STREQUAL "NintendoSwitch")
+    # The POSIX crash reporter is replaced by a Horizon one with the same API.
+    get_target_property(_mp2nx_audio_sources mp_port_audio SOURCES)
+    list(REMOVE_ITEM _mp2nx_audio_sources platform/port_crash.cpp)
+    set_property(TARGET mp_port_audio PROPERTY SOURCES ${_mp2nx_audio_sources})
+    target_sources(mp_port_audio PRIVATE ${MP2NX_ROOT}/switch/source/platform/port_crash_switch.cpp)
+    target_sources(metroid_prime2_port PRIVATE
+        ${MP2NX_ROOT}/switch/source/platform/startup.cpp
+        ${MP2NX_ROOT}/switch/source/platform/low_arena.cpp
+        ${MP2NX_ROOT}/switch/source/platform/posix_stubs.cpp
+        ${MP2NX_ROOT}/switch/source/platform/pthread_wrap.cpp
+        ${MP2NX_ROOT}/switch/source/platform/sqlite_switch.cpp
+        ${MP2NX_ROOT}/switch/source/platform/rename_wrap.cpp)
+    target_sources(mp_port_audio PRIVATE ${MP2NX_ROOT}/switch/source/menu/switch_menu.cpp)
+    set_source_files_properties(${MP2NX_ROOT}/switch/source/menu/switch_menu.cpp PROPERTIES
+        INCLUDE_DIRECTORIES ${CMAKE_CURRENT_SOURCE_DIR}/platform/debug_ui)
+    target_link_libraries(metroid_prime2_port PRIVATE sqlite3)
+    target_link_options(metroid_prime2_port PRIVATE
+        -Wl,--wrap=pthread_detach -Wl,--wrap=pthread_create -Wl,--wrap=rename)
+    target_link_libraries(metroid_prime2_port PRIVATE mp2nx::vulkan)
+    set_target_properties(metroid_prime2_port PROPERTIES OUTPUT_NAME mp2-nx)
+    # Linux pulls in htons/htonl through other headers; Horizon's libc needs arpa/inet.h.
+    set_source_files_properties(platform/port_console.cpp PROPERTIES COMPILE_OPTIONS "-include;arpa/inet.h")
+    # SQLite: no mmap or shared-memory WAL on Horizon, and no extension loading.
+    if(TARGET sqlite3)
+        target_compile_definitions(sqlite3 PRIVATE SQLITE_OMIT_WAL=1 SQLITE_MAX_MMAP_SIZE=0
+            SQLITE_OMIT_LOAD_EXTENSION=1)
+    endif()
+    nx_generate_nacp(mp2-nx.nacp NAME "Metroid Prime 2: Echoes" AUTHOR "mp2-nx" VERSION "0.1.0")
+    nx_create_nro(metroid_prime2_port NACP mp2-nx.nacp OUTPUT ${CMAKE_BINARY_DIR}/mp2-nx.nro)
+endif()
