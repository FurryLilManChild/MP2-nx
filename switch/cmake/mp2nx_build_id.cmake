# mp2-nx: writes the build stamp (cmake -P, run on every build by the mp2nx_build_id target in
# extern/echoes/CMakeLists.txt). The stamp is the first line of every log, on the boot screen and in the
# Switch menu (System), so a log or a running game always says which build it came from.
#   OUT          the C file to write
#   NUMBER_FILE  the build counter (in the build folder), one more each build
#   ROOT         the repo, for the commit the build sits on
set(n 0)
if(EXISTS "${NUMBER_FILE}")
  file(READ "${NUMBER_FILE}" n)
  string(STRIP "${n}" n)
  if(NOT n MATCHES "^[0-9]+$")
    set(n 0)
  endif()
endif()
math(EXPR n "${n} + 1")
file(WRITE "${NUMBER_FILE}" "${n}\n")

string(TIMESTAMP full "%Y-%m-%d %H:%M UTC" UTC)
string(TIMESTAMP short "%m/%d %H:%M UTC" UTC)

set(commit "unknown")
find_program(MP2NX_GIT git)
if(MP2NX_GIT)
  execute_process(COMMAND "${MP2NX_GIT}" -c safe.directory=* -C "${ROOT}" rev-parse --short HEAD
                  OUTPUT_VARIABLE c OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE r)
  if(r EQUAL 0 AND NOT c STREQUAL "")
    set(commit "${c}")
  endif()
endif()

file(WRITE "${OUT}"
  "/* generated by switch/cmake/mp2nx_build_id.cmake on every build */\n"
  "const unsigned mp2nx_build_number = ${n};\n"
  "const char mp2nx_build_id[] = \"build ${n}, made ${full}, on top of commit ${commit}\";\n"
  "const char mp2nx_build_label[] = \"BUILD ${n} - ${short}\";\n")
